{
  "extends": "@myakiba/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "rootDirs": ["."],
    "outDir": "../server/dist",
    "paths": {
      "@/*": ["./src/*"],
      "@server/*": ["../server/src/*"]
    }
  },
  "references": [
    {
      "path": "../server"
    }
  ]
}
