{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js",
    "test": "bun test --isolate --env-file=test.env"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/openapi": "^1.4.14",
    "@elysiajs/static": "^1.4.7",
    "@myakiba/auth": "workspace:*",
    "@myakiba/contracts": "workspace:*",
    "@myakiba/db": "workspace:*",
    "@myakiba/env": "workspace:*",
    "@myakiba/mfc": "workspace:*",
    "@myakiba/redis": "workspace:*",
    "@myakiba/utils": "workspace:*",
    "@paralleldrive/cuid2": "catalog:",
    "better-result": "catalog:",
    "date-fns": "catalog:",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "elysia": "catalog:",
    "evlog": "catalog:",
    "ioredis": "catalog:",
    "web": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.8",
    "@myakiba/config": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-kit": "^0.31.9",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}
